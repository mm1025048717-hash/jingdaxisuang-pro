# 精打细算 Pro 后端环境变量

# JWT 密钥（生产环境务必修改）
JWT_SECRET=your-random-secret-at-least-32-chars

# 微信开放平台 - 网站应用（扫码登录）
# 申请地址：https://open.weixin.qq.com/
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 短信服务（可选，生产环境对接阿里云/腾讯云/容联云）
# SMS_PROVIDER=aliyun
# ALIYUN_ACCESS_KEY=
# ALIYUN_ACCESS_SECRET=

# 端口（默认 3000）
# PORT=3000
