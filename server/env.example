# 精打细算 Pro 后端环境变量

# JWT 密钥（生产环境务必修改）
JWT_SECRET=your-random-secret-at-least-32-chars

# 微信开放平台 - 网站应用（扫码登录）
# 申请地址：https://open.weixin.qq.com/
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 短信服务（可选，生产环境对接阿里云/腾讯云/容联云）
# SMS_PROVIDER=aliyun
# ALIYUN_ACCESS_KEY=
# ALIYUN_ACCESS_SECRET=

# 端口（默认 3000）
# PORT=3000

# OpenClaw 自动启动（默认开启，设 0 关闭）
# OPENCLAW_AUTO_START=0

# OpenClaw 网关 Token（未配置时使用 local-dev-123）
# OPENCLAW_GATEWAY_TOKEN=your-secure-token

# ========== 机会雷达 - 实时数据源（可选） ==========
# 实习僧开放平台 - 真实实习/兼职数据，需联系商务获取
# 文档: https://open.shixiseng.com/
# SHIXISENG_APP_ID=your_app_id
# SHIXISENG_APP_SECRET=your_app_secret

# 聚合数据 招聘信息大全 - 多平台聚合（当前维护中）
# 文档: https://www.juhe.cn/docs/api/id/56
# JUHE_JOB_API_KEY=your_juhe_key

# 58同城开放平台 - 需商务对接
# API_58_APP_KEY=
# API_58_APP_SECRET=
